{
  "name": "jumanji-rpg-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de RPG social de gangues para Discord",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "web": "tsx src/index.ts",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "db:migrate": "tsx src/infrastructure/migrate.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.115.0",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.1",
    "pg": "^8.23.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
