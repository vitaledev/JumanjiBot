# Copie somente para uma instalação nova. Preserve o .env já existente.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TEST_GUILD_ID=
# Conexão direta PostgreSQL; funciona com PostgreSQL local ou Supabase.
DATABASE_URL=postgresql://jumanji:configure-a-password@localhost:5432/jumanji
# Supabase: use a connection string do Postgres (Pooler) em DATABASE_URL.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Gere segredos aleatórios com pelo menos 32 caracteres. Não compartilhe valores.
SESSION_SECRET=
PRIVACY_SECRET=
WEB_ORIGIN=http://localhost:4173
PANEL_ORIGIN=http://localhost:4173
PANEL_URL=http://localhost:4173
WEB_HOST=127.0.0.1
WEB_PORT=4173
FILES_DIR=./data/files
NODE_ENV=development
RUN_WORKER=true
# Ative também os intents correspondentes no Discord Developer Portal.
ENABLE_MESSAGE_ACTIVITY=false
ENABLE_MEMBER_EVENTS=false
ENABLE_VOICE_ACTIVITY=false
ENABLE_REACTION_ACTIVITY=false
INSTAGRAM_POST_URL=https://www.instagram.com/
PANEL_GIF_URL=

